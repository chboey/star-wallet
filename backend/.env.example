# Copy to backend/.env. Frontend :3001, backend :3000. TESTNET ONLY.
# Never put signing keys or provider credentials in the API environment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# Ethereum Sepolia (L1).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Automatically loads ../contracts/deployments/sepolia.json when present.
# Blank values inherit that manifest. Nonempty values override it.
DEPLOYMENT_FILE=
STAR_REGISTRY_ADDRESS=
STAR_TOKEN_ADDRESS=
STAR_GOALS_ADDRESS=
STAR_FAMILY_VAULT_FACTORY_ADDRESS=
STAR_CHILD_ACCOUNT_FACTORY_ADDRESS=
AQUA_ADDRESS=
AQUA_SWAP_VM_ADDRESS=

# Runtime hashes are required before protocol readiness succeeds.
# Blank values inherit the deployment manifest.
STAR_REGISTRY_RUNTIME_CODE_HASH=
STAR_TOKEN_RUNTIME_CODE_HASH=
STAR_GOALS_RUNTIME_CODE_HASH=
STAR_FAMILY_VAULT_FACTORY_RUNTIME_CODE_HASH=
STAR_CHILD_ACCOUNT_FACTORY_RUNTIME_CODE_HASH=
AQUA_RUNTIME_CODE_HASH=
AQUA_SWAP_VM_RUNTIME_CODE_HASH=

# Circle faucet USDC and the project's chosen Sepolia WETH deployment.
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
WETH_ADDRESS=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9

# Sepolia Chainlink feeds and the deployed vault safety limits.
CHAINLINK_ETH_USD_FEED_ADDRESS=0x694AA1769357215DE4FAC081bf1f309aDC325306
CHAINLINK_USDC_USD_FEED_ADDRESS=0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E
CHAINLINK_ETH_USD_MAX_AGE_SECONDS=3600
CHAINLINK_USDC_USD_MAX_AGE_SECONDS=90000
AQUA_DEFAULT_PRICE_BAND_BPS=500
AQUA_MAX_PRICE_DEVIATION_BPS=1000
AQUA_DEFAULT_STRATEGY_LIFETIME_SECONDS=900
AQUA_MAX_STRATEGY_LIFETIME_SECONDS=1800
AQUA_MAX_POSITION_USDC_UNITS=1000000000
AQUA_MAX_POSITION_WETH_UNITS=500000000000000000

# Full GraphQL endpoint for the SAME Sepolia deployment; requires a fresh index.
STAR_SUBGRAPH_URL=
# Exact deployment CID shown by graph deploy / Studio, not the project slug.
# Required for indexed reads; prevents using a different index on the same chain.
STAR_SUBGRAPH_DEPLOYMENT_ID=
# 20 Sepolia blocks is approximately four minutes.
STAR_SUBGRAPH_MAX_BLOCK_LAG=20

# ENSv2 on the SAME Sepolia RPC. Pinned official deployments; no ENS SDK required.
ENS_ROOT_REGISTRY_ADDRESS=0x8115186e8f2e0b0281e86ab91f0f48ba90364354
ENS_ETH_REGISTRY_ADDRESS=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ENS_UNIVERSAL_RESOLVER_ADDRESS=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe
ENS_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENS_USER_REGISTRY_IMPLEMENTATION_ADDRESS=0x624a25d67b59d587752ebec8dded8827dae52050
ENS_PERMISSIONED_RESOLVER_IMPLEMENTATION_ADDRESS=0x9eae5c2730a7dd16bdd1dee6421a1b91e3b0365e
# Deployer owns this namespace on Sepolia ENSv2. Match the deployment/frontend setting.
# Family registrar address/hash are loaded from the Star deployment manifest.
ENS_PARENT_NAME=starwallet.eth
