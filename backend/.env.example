# Copy to backend/.env. Frontend :3001, backend :3000. TESTNET ONLY.
# Never put signing keys or provider credentials in the API environment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# Ethereum Sepolia (L1).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Automatically loads ../contracts/deployments/sepolia.json when present.
# Blank values inherit that manifest. Nonempty values override it.
DEPLOYMENT_FILE=
STAR_REGISTRY_ADDRESS=
STAR_TOKEN_ADDRESS=
STAR_GOALS_ADDRESS=
STAR_FAMILY_VAULT_FACTORY_ADDRESS=
STAR_CHILD_ACCOUNT_FACTORY_ADDRESS=
AQUA_ADDRESS=
AQUA_SWAP_VM_ADDRESS=

# Circle faucet USDC and the project's chosen Sepolia WETH deployment.
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
WETH_ADDRESS=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
