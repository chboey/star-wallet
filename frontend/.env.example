# Server-only backend URL; do not prefix with NEXT_PUBLIC_.
STAR_API_URL=http://127.0.0.1:3000
STAR_API_TIMEOUT_MS=15000

# Passkey hostname comes from the backend/deployment. Open the app on that exact hostname.
# Browser-safe Sepolia RPC (no secret provider credentials).
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ENS_PARENT_NAME is read from the backend; no duplicate frontend setting.
