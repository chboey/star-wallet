SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com


DEPLOYER_PRIVATE_KEY=

# Exact frontend hostname, no scheme/port. Choose the deployed hostname BEFORE deployment.
# Passkeys are bound to this name. localhost is only for local development.
CHILD_ACCOUNT_RP_ID=localhost

# Token addresses and Aqua/SwapVM addresses/hashes come from the Aqua deployment manifest.
# Required oracle and position-safety settings:
CHAINLINK_ETH_USD_FEED_ADDRESS=0x694AA1769357215DE4FAC081bf1f309aDC325306
CHAINLINK_USDC_USD_FEED_ADDRESS=0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E

CHAINLINK_ETH_USD_MAX_AGE_SECONDS=3600
CHAINLINK_USDC_USD_MAX_AGE_SECONDS=90000
AQUA_MAX_PRICE_DEVIATION_BPS=1000
AQUA_MAX_STRATEGY_LIFETIME_SECONDS=1800
AQUA_MAX_POSITION_USDC_UNITS=1000000000
AQUA_MAX_POSITION_WETH_UNITS=500000000000000000
