{
  "name": "@star/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./child-validation-probe": {
      "types": "./abi/child-validation-probe.d.ts",
      "default": "./abi/child-validation-probe.js"
    },
    "./child-account": {
      "types": "./child-account.d.ts",
      "default": "./child-account.js"
    },
    "./network": {
      "types": "./network.d.ts",
      "default": "./network.js"
    },
    "./abi": {
      "types": "./abi/index.d.ts",
      "default": "./abi/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/compile.mjs && forge build --force",
    "fmt:check": "forge fmt --check",
    "test:scripts": "node --test test/*.test.mjs",
    "deploy:all:sepolia": "npm run build && forge test -q && npm run preflight:aqua:sepolia && npm run deploy:aqua:sepolia && npm run preflight:sepolia && npm run deploy:sepolia && npm run preflight:ens:sepolia && npm run setup:ens:sepolia",
    "preflight:aqua:sepolia": "DRY_RUN=true node --env-file-if-exists=.env scripts/deploy-aqua.mjs",
    "deploy:aqua:sepolia": "node --env-file-if-exists=.env scripts/deploy-aqua.mjs",
    "preflight:sepolia": "DRY_RUN=true node --env-file-if-exists=.env scripts/deploy.mjs",
    "deploy:sepolia": "node --env-file-if-exists=.env scripts/deploy.mjs",
    "verify:sepolia": "node --env-file-if-exists=.env scripts/verify.mjs",
    "verify:family-vault": "node --env-file-if-exists=.env scripts/verify-family-vault.mjs",
    "preflight:ens:sepolia": "npm --prefix ../backend run ens:setup",
    "setup:ens:sepolia": "npm --prefix ../backend run ens:setup -- --broadcast"
  },
  "devDependencies": {
    "@1inch/solidity-utils": "6.9.10",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-passkeys": "npm:@openzeppelin/contracts@5.6.1",
    "solc": "0.8.30",
    "viem": "^2.36.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
