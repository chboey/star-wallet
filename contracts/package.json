{
  "name": "@star/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./child-validation-probe": {
      "types": "./abi/child-validation-probe.d.ts",
      "default": "./abi/child-validation-probe.js"
    },
    "./child-account": {
      "types": "./child-account.d.ts",
      "default": "./child-account.js"
    },
    "./abi": {
      "types": "./abi/index.d.ts",
      "default": "./abi/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/compile.mjs && forge build --force",
    "fmt:check": "forge fmt --check",
    "test": "forge test",
    "test:scripts": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@1inch/solidity-utils": "6.9.10",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-passkeys": "npm:@openzeppelin/contracts@5.6.1",
    "solc": "0.8.30",
    "viem": "^2.36.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
